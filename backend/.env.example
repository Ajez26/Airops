PORT=3000

# Database (individual params — used by pool.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airops
DB_USER=airops
DB_PASSWORD=airops_dev_password

# Firebase Admin SDK — paste your service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"...","client_email":"..."}

# CORS
ALLOWED_ORIGINS=http://localhost:3001,https://airops.app

# JWT (fallback if not using Firebase verification)
JWT_SECRET=change-me-in-production
